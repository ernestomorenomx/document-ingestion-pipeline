# PostgreSQL
POSTGRES_USER=brainvault
POSTGRES_DB=brainvault
POSTGRES_PASSWORD=your_password_here
POSTGRES_PORT=5432

# n8n
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_password_here

# MarkItDown
MARKITDOWN_HOST=markitdown
MARKITDOWN_PORT=8000

# Host paths for deploy/production.compose.yml (generic examples, set real values in .env)
POSTGRES_DATA_DIR=/srv/brainvault/postgres
VAULT_DIR=/srv/brainvault/vault
N8N_DATA_DIR=/srv/brainvault/n8n
SYNCTHING_CONFIG_DIR=/srv/brainvault/syncthing-config

# Password manager backup (scripts/backup-vaultwarden.sh)
VW_DATA_DIR=/srv/brainvault/vaultwarden
