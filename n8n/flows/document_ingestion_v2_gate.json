    {
      "parameters": {
        "jsCode": "const results = [];\nconst items = $input.all();\n\nfor (let i = 0; i < items.length; i++) {\n  const stdout = items[i].json.stdout;\n  const match = stdout.trim().match(/^(\\S+)\\s+(.+)$/);\n  const hash = match[1];\n  const fullPath = match[2];\n  const filename = fullPath.split('/').pop();\n\n  if (filename.endsWith('.procesando') || filename.startsWith('.')) continue;\n\n  results.push({\n    json: {\n      filename: filename,\n      hash_sha256: hash,\n      raw_path: '/raw/2026/' + filename\n    },\n    pairedItem: i\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -272,
        96
      ],
      "id": "0d8f566d-5dbd-4f68-89b0-209f60205dbd",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// Nota: existingDocs es data de referencia (todos los hashes ya conocidos en la BD),\n// no está pareada item-a-item con 'documents'. documents SI define el output 1:1.\nconst existingDocs = $input.all().map(item => ({\n  hash: item.json.hash_sha256,\n  status: item.json.status,\n  content_md: item.json.content_md\n}));\n\nconst documents = $('Code in JavaScript').all();\nconst results = [];\n\nfor (let i = 0; i < documents.length; i++) {\n  const doc = documents[i];\n  const existing = existingDocs.find(e => e.hash === doc.json.hash_sha256);\n\n  const needsProcessing = !existing ||\n                          existing.status === 'pending' ||\n                          !existing.content_md;\n\n  results.push({\n    json: {\n      ...doc.json,\n      is_new: needsProcessing\n    },\n    pairedItem: i\n  });\n}\n\nreturn results;"
      },
