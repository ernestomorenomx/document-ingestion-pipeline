        "query": "INSERT INTO document (hash_sha256, original_name, mime_type, raw_path, content_md, status, version_lock, ocr_engine)\nVALUES ($1, $2, $3, $4, $5, 'ready', 0, $6)\nON CONFLICT (hash_sha256) DO UPDATE\nSET content_md = EXCLUDED.content_md,\n    status = 'ready',\n    version_lock = document.version_lock + 1,\n    updated_at = now(),\n    ocr_engine = EXCLUDED.ocr_engine\nRETURNING original_name, content_md;",
        "options": {
          "queryReplacement": "={{ [$('Edit Fields').item.json.hash_sha256, $('Edit Fields').item.json.filename, $('Edit Fields').item.json.filename.endsWith('.pdf') ? 'application/pdf' : 'application/octet-stream', $('Edit Fields').item.json.raw_path, $json.markdown, $json.ocr_engine ?? 'markitdown'] }}"
        }
