    {
      "parameters": {
        "jsCode": "const results = [];\nconst items = $input.all();\n\nfor (let i = 0; i < items.length; i++) {\n  const markdown = items[i].json.content_md || '';\n  const originalFilename = items[i].json.original_name;\n  const filename = originalFilename.replace(/\\.[^.]+$/, '.md');\n\n  results.push({\n    json: { filename, original_filename: originalFilename },\n    binary: {\n      data: await this.helpers.prepareBinaryData(\n        Buffer.from(markdown, 'utf-8'),\n        filename,\n        'text/markdown'\n      )\n    },\n    pairedItem: i\n  });\n}\n\nreturn results;"
      },
