    {
      "parameters": {
        "jsCode": "const results = [];\nconst items = $input.all();\n\nfor (let i = 0; i < items.length; i++) {\n  const ocrText = items[i].json.stdout || '';\n  const editFields = $('Edit Fields').itemMatching(i);\n\n  results.push({\n    json: {\n      ...editFields.json,\n      markdown: ocrText,\n      ocr_engine: 'tesseract'\n    },\n    pairedItem: i\n  });\n}\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2128,
